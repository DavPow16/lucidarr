# lucidarr config — modelled on Soularr's config.ini.
# Copy to config.ini (next to where you run lucida), or set LUCIDARR_CONFIG / --config.
# Command-line options and env vars override anything here.
# Lists are comma-separated with no spaces around the commas.

[Lidarr]
# Lidarr > Settings > General > Security.
api_key = yourlidarrapikeygoeshere
# URL lucidarr uses to reach Lidarr.
host_url = http://lidarr:8686
# The staging folder (see [Lucida] download_dir) as LIDARR sees it. Leave empty when
# both use the same path.
download_dir =
# If True, lucidarr downloads but Lidarr is not asked to import (files stay in staging).
disable_sync = False
# How Lidarr is told to import. scan = DownloadedAlbumsScan on a folder named
# "Artist - Album (Year)" with tags set like Soularr does. manual = Lidarr's Manual Import
# API (matches files to the wanted album, reports per-file rejection reasons).
# auto = scan first, then Manual Import if files were left behind.
import_method = auto

# Replaces Soularr's [Slskd]: lucida.to is the download source.
[Lucida]
# Local staging folder lucidarr downloads into (one sub-folder per album).
# Empty = <music folder>/.lidarr
download_dir = /data/lucidarr_downloads
# qobuz, amazon or grilledcheese. Falls back to the others when nothing matches.
service = qobuz
country =
# Parallel track downloads.
jobs = 3
# Convert locally before import: mp3, aac, opus, ogg, wav or flac. Empty = keep source.
convert_to =
bitrate =
# Off-screen browser window when a Cloudflare re-check is needed.
hidden = False
# Maximum seconds to wait for Lidarr's import scan, to prevent infinite hangs.
import_timeout = 900
# Optional: a FlareSolverr or Byparr URL (e.g. http://192.168.1.20:8191) that clears
# Cloudflare for lucida.to. It must reach the internet from the same public IP as this
# host. When set, lucidarr asks it for the cf_clearance + user agent whenever it needs a
# fresh one, instead of opening a browser. Byparr is known to pass; FlareSolverr timed out.
solver_url =
# Maximum seconds to let the solver work on one challenge.
solver_timeout = 90

# Soularr's [Release Settings] (accepted_countries/formats, multi-disc) have no
# equivalent: lucida.to serves a single release per album.

[Search Settings]
# Lidarr source: missing or cutoff_unmet.
search_source = missing
# all = every wanted album; first_page = always the first page; incrementing_page =
# start at the first page and move on each run.
search_type = incrementing_page
# Albums processed per run (also the page size).
number_of_albums_to_grab = 10
# Unmonitor an album in Lidarr when nothing could be downloaded; it is also logged to
# failure_list.txt in the app data folder.
remove_wanted_on_failure = False
# Hours before an album that failed is attempted again (0 = every run).
retry_after_hours = 24
# Seconds between cycles when running continuously (0 = run once and exit).
# --interval / SCRIPT_INTERVAL override this.
interval = 900
# Skip wanted albums whose title contains any of these words. Case-insensitive.
# e.g. title_blacklist = karaoke,tribute   (substring match on the album title)
title_blacklist =

[Web]
# `lucida web` serves a page for uploading a Cloudflare clearance from a machine that has
# a desktop (see README). Plain HTTP for a trusted LAN only. It refuses to start
# without a password.
host = 0.0.0.0
port = 8787
password =

[Logging]
# Passed to Python's logging.basicConfig().
level = INFO
format = [%(levelname)s|%(module)s|L%(lineno)d] %(asctime)s: %(message)s
datefmt = %Y-%m-%dT%H:%M:%S%z
